{
  "Import": {
    "prefix": "import",
    "body": "import { ${0:${CLIPBOARD/[^\\0]*?import\\s*\\(\\s*\"([^\\0]*?)\"\\s*\\)\\s*(?:\\.\\s*(\\w+))?[^\\0]*|[^\\0]*?import\\s*(?:\u007B\\s*([^\\0]*?)\\s*\u007D|\\*\\s*as\\s+\\w+)\\s*from\\s*\"([^\\0]*?)\"[^\\0]*|[^\\0]*/$2$3/}} } from \"${1:${CLIPBOARD/[^\\0]*?import\\s*\\(\\s*\"([^\\0]*?)\"\\s*\\)\\s*(?:\\.\\s*(\\w+))?[^\\0]*|[^\\0]*?import\\s*(?:\u007B\\s*([^\\0]*?)\\s*\u007D|\\*\\s*as\\s+\\w+)\\s*from\\s*\"([^\\0]*?)\"[^\\0]*|[^\\0]*/$1$4/}}\";",
    "description": "If an import statement has been copied, the contents of it will be pasted with this snippet.",
  },

  "If Statement": {
    "prefix": "if",
    "body": [
      "if ($1)",
      "{",
      "\t$0",
      "}",
    ],
  },
  "Switch Statement": {
    "prefix": "switch",
    "body": [
      "switch ($1)",
      "{",
      "\tcase $0:",
      "\t\tbreak;",
      "\tdefault:",
      "\t\tbreak;",
      "}",
    ],
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ($1)",
      "{",
      "\t$0",
      "}",
    ],
  },
  "Do-While Loop": {
    "prefix": "dowhile",
    "body": [
      "do",
      "{",
      "\t$0",
      "}",
      "while ($1);",
    ],
  },
  "For-Of Loop": {
    "prefix": ["foreach", "forof"],
    "body": [
      "for (const ${1:element} of ${2:array})",
      "{",
      "\t$0",
      "}",
    ],
  },
  "For-In Loop": {
    "prefix": "forin",
    "body": [
      "for (const ${1:key} in ${2:object})",
      "{",
      "\t$0",
      "}",
    ],
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (let ${1:i} = 0; ${1:i} < ${2:length}; ${1:i} += 1)",
      "{",
      "\t$0",
      "}",
    ],
  },
  "For-Await Loop": {
    "prefix": "forawait",
    "body": [
      "for await (const ${1:element} in ${2:object})",
      "{",
      "\t$0",
      "}",
    ],
  },
  "Throw Error": {
    "prefix": "throw",
    "body": "throw new ${1|Error,TypeError,SyntaxError,RangeError,ReferenceError|}($0);",
  },
  "Guard This": {
    "prefix": "guardthis",
    "body": [
      "if (!(this instanceof ${1:/* class */}))",
      "\tthrow new TypeError(",
      "\t\t`'${2:function}' called on an object that does not implement interface ${1:class}.`);",
    ],
  },
  "Guard Argument Is Class": {
    "prefix": "guardarg",
    "body": [
      "if (${1:arg} === null || typeof ${1:arg} !== \"object\")",
      "\tthrow new TypeError(",
      "\t\t`${3:class}.${4:function}: Argument ${5:N} is not an object.`);",
      "else if (!(${1:arg} instanceof ${2:/* class */}))",
      "\tthrow new TypeError(",
      "\t\t`${3:class}.${4:function}: Argument ${5:N} does not implement interface ${2:class}.`);",
    ],
  },
  "Guard Argument Is Function": {
    "prefix": "guardfn",
    "body": [
      "if (${1:arg} === null || typeof ${1:arg} !== \"object\")",
      "\tthrow new TypeError(",
      "\t\t`${2:class}.${3:function}: Argument ${4:N} is not an object.`);",
      "else if (typeof ${1:arg} !== \"function\")",
      "\tthrow new TypeError(",
      "\t\t`${2:class}.${3:function}: Argument ${4:N} does is not callable.`);",
    ],
  },

  "Custom HTMLElement": {
    "prefix": [ "classHTMLElement", "customElement" ],
    "body": [
      "export class ${1:CustomClass} extends HTMLElement",
      "{",
      "\tstatic readonly observedAttributes = Object.freeze((",
      "\t[",
      "\t\t",
      "\t]",
      "\t) as const);",
      "",
      "\tconnectedCallback()",
      "\t{",
      "\t\tif (!(this instanceof ${1:CustomClass}))",
      "\t\t\tthrow new TypeError(",
      "\t\t\t\t`'connectedCallback' called on an object that does not ` +",
      "\t\t\t\t`implement interface ${1:CustomClass}.`);",
      "",
      "\t\t",
      "\t}",
      "",
      "\tdisconnectedCallback()",
      "\t{",
      "\t\tif (!(this instanceof ${1:CustomClass}))",
      "\t\t\tthrow new TypeError(",
      "\t\t\t\t`'disconnectedCallback' called on an object that does not ` +",
      "\t\t\t\t`implement interface ${1:CustomClass}.`);",
      "",
      "\t\t",
      "\t}",
      "",
      "\tattributeChangedCallback(",
      "\t\tattributeName: typeof ${1:CustomClass}[\"observedAttributes\"][number],",
      "\t\toldValue: string | null,",
      "\t\tnewValue: string | null)",
      "\t{",
      "\t\tif (!(this instanceof ${1:CustomClass}))",
      "\t\t\tthrow new TypeError(",
      "\t\t\t\t`'attributeChangedCallback' called on an object that does not` +",
      "\t\t\t\t` implement interface ${1:CustomClass}.`);",
      "",
      "\t\toldValue = oldValue == null ? null : String(oldValue);",
      "\t\tnewValue = newValue == null ? null : String(newValue);",
      "",
      "\t\tswitch (String(attributeName) as typeof attributeName)",
      "\t\t{",
      "\t\t\t",
      "\t\t}",
      "\t}",
      "}",
      "",
      "customElements.define(\"${2:custom-element}\", ${1:CustomClass});"
    ],
  },

  "Console Log Line": {
    "prefix": "debug",
    "body": "\nconsole.log(`${TM_CURRENT_LINE/(?:\\w|(?<=\\w)\\.(?!\\.)(?=\\w))+(?![\\w.]*\\s*\\()(?<!(?=return(?!\\w)|this(?![\\w.])|let(?![\\w.])|var(?![\\w.])|const(?![\\w.])|super(?![\\w.])|if(?!\\w)|else(?!\\w)|for(?!\\w)|switch(?!\\w)|case(?!\\w)|function(?!\\w))[\\w.]*)(?!d?e?b?u?g?$)/$\u007B$0\u007D/gm}`);",
  }
}